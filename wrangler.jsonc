{
  "name": "kairos-local",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-06-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kairos-rooms",
      "database_id": "local-kairos-rooms",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "WORLD_ROOMS", "class_name": "WorldRoom" }]
  },
  "migrations": [{ "tag": "world-rooms-v1", "new_classes": ["WorldRoom"] }],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
