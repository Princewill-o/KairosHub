  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test *.test.mjs",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write public/*.js public/*.mjs public/styles.css server/*.mjs",
    "build": "node scripts/build.mjs",
