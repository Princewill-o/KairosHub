  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "drizzle-kit": "0.30.6",
    "esbuild": "0.19.12",
    "prettier": "3.6.2",
    "wrangler": "4.104.0"
  },
  "dependencies": {
    "drizzle-orm": "0.38.4",
    "ws": "^8.21.3"
  }
